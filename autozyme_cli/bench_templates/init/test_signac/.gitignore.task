# zyme state (best.ref, round.counter)
.zyme/

# Generated agent prompts with task's inputs baked in (regenerated by zyme commands)
prompts/

# Dataset cache — runtime tier inputs (referenced by task.yaml::datasets),
# raw upstream under data/_raw/, optional static refs under data/_refs/.
# Populated by setup/ scripts (which ARE tracked); contents must be
# reproducible from a fresh clone via `bash setup/<scripts>`. Never put
# prep code in here — that goes in setup/.
# No trailing slash so the rule matches both a real `data/` dir and a
# symlink (some tasks symlink data → ../../datasets/per_task/<task>).
data

# Upstream source (git-cloned by init agent when target_repo is a URL)
upstream_repo/

# Reference output is regenerated on demand (delete to force rerun).
# `reference_outputs/` (plural) is the current convention — per-tier subdirs
# under one parent. The two legacy patterns are kept for backward compat with
# tasks scaffolded before the reorganization.
reference_outputs/
reference_output/
reference_output_*/

# Per-round snapshots (incl. per-tier run.log) — kept locally for meta-analysis, not in git
artifacts/

# Append-only state — the framework manages these, git tracks code only
results.tsv
validate.tsv
verify.tsv
package_verify.tsv
audit_reports/
memory/discoveries.md
memory/active_opts.md
memory/dead_ends.md
memory/transfer_kit.md
memory/transfer_knowledge.md
memory/best_state.md

# Pipeline output between run.py and evaluate.py — regenerated each round
pipeline/*.csv
pipeline/*.npz
pipeline/*.rds
pipeline/*.h5ad
pipeline/*.pkl
pipeline/*.parquet
pipeline/*.feather
pipeline/output/
pipeline/output_*/
pipeline/output-*/
pipeline/metrics.json

# Profile artifacts — regenerated by `zyme profile` / `ZYME_PROFILE=1 zyme run`
pipeline/profile.out
pipeline/profile.json
pipeline/Rprof.out
pipeline/scalene.json
pipeline/memray.bin
pipeline/profvis.html
pipeline/profvis_files/
pipeline/native_sample_*.txt
pipeline/native_sample_*.stderr
pipeline/.rcpp_cache/
profile_history/

# Framework housekeeping state (auto-written by zyme commands)
.zyme_housekeeping.json

# Local-only manual backups (not part of published artifact)
backups/

# macOS metadata
.DS_Store

# Python
__pycache__/
*.pyc

# R
.RData
.Rhistory
.Rapp.history
