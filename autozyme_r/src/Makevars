# --no-init-file --no-site-file: do NOT source the user's .Rprofile / Rprofile.site
# when querying RcppParallel flags. Anything those profiles print to stdout (e.g. a
# CRAN-mirror banner like "CRAN镜像已设置为清华大学(TUNA)源") would otherwise be
# captured by $(shell ...) and spliced into the g++ command line, breaking the build
# (a stray "(" trips the shell). .Renviron is still read, so custom library paths
# (R_LIBS_USER) keep working. See GitHub issue #1.
RSCRIPT = "${R_HOME}/bin/Rscript" --no-init-file --no-site-file
RCPPPARALLEL_LIBDIR = $(shell $(RSCRIPT) -e "cat(system.file('lib', package='RcppParallel'))")
PKG_CPPFLAGS = -I. -DSCBLAS_BUILDING
# Accelerate framework is intentionally NOT linked at build time. wgcna.cpp
# resolves cblas_dgemm via dlopen on first call instead. Link-time
# `-framework Accelerate` poisons EVERY BLAS symbol in autozyme.so to route
# through Accelerate (including kernels that intend to use R's reference
# libRblas via Armadillo). Accelerate's BLAS thread pool is not fork-safe,
# so any patch that uses mclapply (monocle3, ...) segfaults in forked
# children at address ~0x110 the moment a BLAS symbol is touched. Lazy
# dlopen scopes the Accelerate dependency to wgcna's single kernel — the
# rest of autozyme.so stays on single-threaded reference BLAS and is
# fork-safe by default.
ACCELERATE_LIBS =

# libomp detection for cellchat.cpp (raw OpenMP pragmas). Apple Clang ships
# libomp separately; we hunt homebrew/anaconda/macports paths the same way
# pipeline/run.R::configure_openmp_toolchain does. Empty on Linux (gcc/clang
# have built-in OpenMP) — there we let R's default OMP flags apply via
# $(SHLIB_OPENMP_CXXFLAGS), or fall back to serial when neither is set.
# Compile-time `#ifdef _OPENMP` in cellchat.cpp keeps the serial path correct.
OMP_INCLUDE_DIR = $(shell \
  for d in /opt/homebrew/opt/libomp/include /opt/anaconda3/include /opt/local/include/libomp /opt/local/include /usr/local/include; do \
    if [ -f "$$d/omp.h" ]; then echo "$$d"; break; fi; \
  done)
OMP_LIB_DIR = $(shell \
  for d in /opt/homebrew/opt/libomp/lib /opt/anaconda3/lib /opt/local/lib/libomp /opt/local/lib /usr/local/lib; do \
    if [ -f "$$d/libomp.dylib" ]; then echo "$$d"; break; fi; \
  done)
DARWIN_OMP_CXX = $(shell uname -s | grep -q Darwin && test -n "$(OMP_INCLUDE_DIR)" && echo "-Xclang -fopenmp -I$(OMP_INCLUDE_DIR)")
# OpenMP runtime: link R's OWN libomp (${R_HOME}/lib/libomp.dylib) so the whole
# R process shares a SINGLE OpenMP runtime. Linking a *different* libomp (e.g.
# Homebrew's, which this Makevars used to force) loads a second LLVM OpenMP
# runtime; on macOS arm64 that segfaults inside __kmp_suspend_initialize_thread
# (a worker finds a NULL kmp_info_t) the instant a worker thread is spawned, so
# EVERY schedule(dynamic) kernel (normalize/scale/sctransform/markers) crashed
# at >1 thread. KMP_DUPLICATE_LIB_OK=TRUE does not help. (The old note here
# claimed R's libomp was "x86_64-only and lacks __kmpc_dispatch_deinit": on
# modern arm64 R it is a universal binary, and only that one symbol is missing
# -- src/omp_compat.cpp supplies it as a no-op so linking R's libomp succeeds.)
# We still COMPILE against Homebrew's omp.h (DARWIN_OMP_CXX, ABI-compatible);
# only the link target changes. Falls back to Homebrew's libomp if R ships none.
DARWIN_OMP_LD  = $(shell uname -s | grep -q Darwin && { \
  if [ -f "${R_HOME}/lib/libomp.dylib" ]; then echo "${R_HOME}/lib/libomp.dylib"; \
  elif [ -n "$(OMP_LIB_DIR)" ]; then echo "$(OMP_LIB_DIR)/libomp.dylib -Wl,-rpath,$(OMP_LIB_DIR)"; fi; })

# Seurat patch kernels (seurat_*.cpp) use #pragma omp parallel for and benefit
# from -O3 on tight sort/reduce loops. $(SHLIB_OPENMP_CXXFLAGS) is supplied by
# R per-platform (-fopenmp on Linux/Rtools; empty on macOS where the Darwin
# variables above take over).
PKG_CXXFLAGS = $(shell $(RSCRIPT) -e "RcppParallel::CxxFlags()") -DRCPP_PARALLEL_USE_TBB=1 $(SHLIB_OPENMP_CXXFLAGS) $(DARWIN_OMP_CXX) -O3
PKG_LIBS = $(shell $(RSCRIPT) -e "RcppParallel::RcppParallelLibs()") -Wl,-rpath,$(RCPPPARALLEL_LIBDIR) $(ACCELERATE_LIBS) $(SHLIB_OPENMP_CXXFLAGS) $(DARWIN_OMP_LD)
CXX_STD = CXX17
