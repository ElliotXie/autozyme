# --no-init-file --no-site-file: do NOT source the user's .Rprofile / Rprofile.site
# when querying RcppParallel flags. Anything those profiles print to stdout (e.g. a
# CRAN-mirror banner like "CRAN镜像已设置为清华大学(TUNA)源") would otherwise be
# captured by $(shell ...) and spliced into the g++ command line, breaking the build.
# .Renviron is still read, so custom library paths keep working. See GitHub issue #1.
RSCRIPT = "${R_HOME}/bin${R_ARCH_BIN}/Rscript" --no-init-file --no-site-file
RCPPPARALLEL_LIBDIR = $(shell $(RSCRIPT) -e "cat(system.file('lib', package='RcppParallel'))")
PKG_CPPFLAGS = -I. -DSCBLAS_BUILDING
PKG_CFLAGS = -pthread -O3
PKG_CXXFLAGS = $(shell $(RSCRIPT) -e "RcppParallel::CxxFlags()") -DRCPP_PARALLEL_USE_TBB=1 $(SHLIB_OPENMP_CXXFLAGS) -pthread -O3
PKG_LIBS = $(shell $(RSCRIPT) -e "RcppParallel::RcppParallelLibs()") $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) $(SHLIB_OPENMP_CXXFLAGS) -pthread
CXX_STD = CXX17
